{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "types": ["vite/client"],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "noEmit": true,
    // Temporary, while the code converted from JavaScript gets explicit parameter types and null
    // handling (TypeScript's recommended migration path: convert first, then turn these on one at a
    // time). Everything else in "strict" is on. See docs/internal/gaps-and-quirks.md.
    "noImplicitAny": false,
    "strictNullChecks": false,
    "paths": { "@/*": ["./src/*"] }
  },
  "include": ["src", "vite.config.mts"]
}
