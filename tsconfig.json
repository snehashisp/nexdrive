{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "types": ["vite/client"],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "noEmit": true,
    // Existing .js/.jsx files keep compiling while they are converted feature by feature;
    // they are not type-checked until renamed to .ts/.tsx.
    "allowJs": true,
    "checkJs": false,
    "paths": { "@/*": ["./src/*"] }
  },
  "include": ["src", "vite.config.mts"]
}
