{
  "name": "nexdrive",
  "version": "1.0.0",
  "private": true,
  "description": "NexDrive — installable PWA (lessons, learners, bookings for UK driving instructors). React + Vite front end, served by a small Node.js/Express server for GoDaddy Node.js Hosting.",
  "type": "commonjs",
  "main": "server.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node build.js",
    "prestart": "npm run build",
    "start": "node server.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write src \"*.{ts,mjs}\"",
    "format:check": "prettier --check src \"*.{ts,mjs}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "engines": {
    "node": ">=20.19"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^6.1.2",
    "express": "^4.21.2",
    "qrcode-generator": "^2.0.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vite": "^8.3.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.8",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.1.1"
  }
}
